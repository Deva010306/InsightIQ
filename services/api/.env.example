# =============================================
# InsightIQ API — Environment Variables
# Copy to .env and fill in your values.
# =============================================

# --- Application ---
APP_ENV=development
APP_NAME=InsightIQ API
APP_VERSION=0.1.0
DEBUG=true
LOG_LEVEL=INFO

# --- API Server ---
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=GENERATE_WITH_openssl_rand_hex_32

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# --- PostgreSQL ---
DATABASE_URL=postgresql+asyncpg://insightiq_user:insightiq_dev_password@localhost:5432/insightiq
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_ECHO=false

# --- ClickHouse ---
CLICKHOUSE_URL=http://insightiq_ch:insightiq_ch_dev_password@localhost:8123/insightiq_analytics
CLICKHOUSE_MAX_CONNECTIONS=10

# --- Qdrant ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# --- Redis ---
REDIS_URL=redis://:insightiq_redis_dev_password@localhost:6379/0
REDIS_POOL_SIZE=20

# --- Authentication ---
JWT_SECRET_KEY=GENERATE_WITH_openssl_rand_hex_32
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60

# --- AI Orchestrator (internal) ---
AI_ORCHESTRATOR_URL=http://localhost:8001
AI_ORCHESTRATOR_API_KEY=CHANGE_ME_INTERNAL

# --- LLM Gateway (internal) ---
LLM_GATEWAY_URL=http://localhost:8002
LLM_GATEWAY_API_KEY=CHANGE_ME_INTERNAL

# --- Object Storage ---
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
AWS_REGION=us-east-1
S3_BUCKET_NAME=insightiq-uploads-dev

# --- Rate Limiting ---
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_AI_PER_MINUTE=10

# --- OpenTelemetry ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=insightiq-api
