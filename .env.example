# =============================================
# InsightIQ — Root Environment Variables
# Copy this to .env in each service directory.
# NEVER commit .env files with real values.
# =============================================

# --- Application ---
APP_ENV=development
APP_NAME=InsightIQ
APP_VERSION=0.1.0
DEBUG=true
LOG_LEVEL=INFO

# --- Core API ---
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=CHANGE_ME_USE_OPENSSL_RAND_HEX_32
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# --- PostgreSQL (OLTP) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=insightiq
POSTGRES_USER=insightiq_user
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
DATABASE_URL=postgresql+asyncpg://insightiq_user:CHANGE_ME_POSTGRES_PASSWORD@localhost:5432/insightiq

# --- ClickHouse (OLAP) ---
CLICKHOUSE_HOST=localhost
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_DB=insightiq_analytics
CLICKHOUSE_USER=insightiq_ch
CLICKHOUSE_PASSWORD=CHANGE_ME_CLICKHOUSE_PASSWORD

# --- Qdrant (Vector Database) ---
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=                 # Leave empty for local development

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@localhost:6379/0

# --- LLM Providers ---
OPENAI_API_KEY=sk-CHANGE_ME
ANTHROPIC_API_KEY=CHANGE_ME
AZURE_OPENAI_API_KEY=CHANGE_ME
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# --- Embedding Models ---
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_EMBEDDING_SMALL_MODEL=text-embedding-3-small

# --- Authentication ---
JWT_SECRET_KEY=CHANGE_ME_JWT_SECRET
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60
AUTH0_DOMAIN=your-domain.auth0.com
AUTH0_AUDIENCE=https://api.insightiq.ai

# --- Object Storage (S3-compatible) ---
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
AWS_REGION=us-east-1
S3_BUCKET_NAME=insightiq-uploads
S3_ENDPOINT_URL=                # Leave empty for AWS S3, set for MinIO/R2

# --- AI Orchestrator ---
AI_ORCHESTRATOR_URL=http://localhost:8001
AI_ORCHESTRATOR_API_KEY=CHANGE_ME_INTERNAL_KEY

# --- LLM Gateway ---
LLM_GATEWAY_URL=http://localhost:8002
LLM_GATEWAY_API_KEY=CHANGE_ME_INTERNAL_KEY

# --- Temporal ---
TEMPORAL_HOST=localhost
TEMPORAL_PORT=7233
TEMPORAL_NAMESPACE=insightiq

# --- OpenTelemetry ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=insightiq-api
OTEL_TRACES_ENABLED=true
OTEL_METRICS_ENABLED=true

# --- Security ---
MAX_FILE_UPLOAD_MB=50
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_AI_PER_MINUTE=10
