.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/
.uv/
__pypackages__/

# --- uv ---
uv.lock

# --- Type checking ---
.mypy_cache/
.dmypy.json
dmypy.json
.pytype/
.pyre/

# --- IDEs ---
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
