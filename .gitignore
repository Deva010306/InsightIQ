# --- Secrets & Environment ---
.env
.env.*
!.env.example
!.env.docker
*.pem
*.key
secrets/

# --- Docker ---
infrastructure/docker/data/
infrastructure/docker/.env

# --- Logs ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Database migrations (keep the folder, ignore auto-generated) ---
# migrations/versions/*.py — keep tracked, do not ignore

# --- ML / Data ---
*.h5
*.pkl
*.joblib
*.parquet
*.csv.gz
data/
models/
mlruns/
mlflow.db

# --- Jupyter ---
.ipynb_checkpoints
*.ipynb

# --- OS ---
Thumbs.db
.DS_Store
Desktop.ini

# --- Terraform ---
infrastructure/terraform/**/.terraform/
